# QuantEdge Terminal / Kalici web UI
# Copy to .env.local for local overrides. Secrets stay server-side only.

# Feedback email (optional — /api/feedback)
FEEDBACK_TO=sbarryfr@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=QuantEdge Terminal <your-sender@gmail.com>

# IAM ledger (order history / trading proxy on /legacy and /api/*)
# Default: http://127.0.0.1:8000 — started by Investment-Management.bat
# LEDGER_URL=http://127.0.0.1:8000

# Coinbase public market data is fetched server-side via /api/coinbase
# and /api/coinbase/market — no API key required for public Exchange endpoints.
# Do not put brokerage or private Coinbase credentials in front-end code.
